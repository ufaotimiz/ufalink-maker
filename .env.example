# PostgreSQL (Neon)
# Em https://console.neon.tech → seu projeto → Connection string, copie as DUAS strings:
#
# 1) "Pooled" (com -pooler no host) — usada em runtime pelo Next/Vercel.
#    Adicione ?sslmode=require&pgbouncer=true&connect_timeout=15 no final.
DATABASE_URL="postgresql://user:pass@ep-xxx-pooler.region.neon.tech/dbname?sslmode=require&pgbouncer=true&connect_timeout=15"
#
# 2) "Direct" (sem -pooler) — usada por `prisma migrate`.
#    Adicione ?sslmode=require no final.
DIRECT_URL="postgresql://user:pass@ep-xxx.region.neon.tech/dbname?sslmode=require"

# Auth.js (NextAuth v5) — gere com: openssl rand -base64 32
AUTH_SECRET="trocar-em-producao"

# Google OAuth — crie em https://console.cloud.google.com/apis/credentials
# Authorized redirect URIs:
#   http://localhost:3000/api/auth/callback/google  (dev)
#   https://link-maker-zeta.vercel.app/api/auth/callback/google  (prod)
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""
