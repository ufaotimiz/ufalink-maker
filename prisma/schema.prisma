// Link Maker — schema for multi-tenant client page builder
// Generates Prisma Client with: `npx prisma generate`
// Migrate with: `npx prisma migrate dev --name <name>`

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// ============================================================
// NextAuth.js v5 (Auth.js) — standard models
// Docs: https://authjs.dev/getting-started/adapters/prisma
// ============================================================

model User {
  id            String       @id @default(cuid())
  name          String?
  email         String?      @unique
  emailVerified DateTime?
  image         String?
  accounts      Account[]
  sessions      Session[]
  clientPages   ClientPage[]
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ============================================================
// Produto — páginas montadas pelas agências
// ============================================================

enum ThemeMode {
  LIGHT
  DARK
  AUTO
}

enum SocialPlatform {
  INSTAGRAM
  FACEBOOK
  TIKTOK
  X
  YOUTUBE
  LINKEDIN
  WHATSAPP
  WEBSITE
  EMAIL
}

model ClientPage {
  id          String         @id @default(cuid())
  slug        String         @unique
  ownerId     String
  owner       User           @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  name        String
  bio         String?        @db.Text
  avatarUrl   String?
  coverUrl    String?

  themeColor  String         @default("#0f172a")
  themeMode   ThemeMode      @default(LIGHT)

  socialLinks SocialLink[]
  buttons     CustomButton[]
  gallery     GalleryImage[]

  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@index([ownerId])
}

model SocialLink {
  id           String         @id @default(cuid())
  clientPageId String
  clientPage   ClientPage     @relation(fields: [clientPageId], references: [id], onDelete: Cascade)

  platform     SocialPlatform
  url          String
  order        Int            @default(0)

  @@index([clientPageId])
}

model CustomButton {
  id           String     @id @default(cuid())
  clientPageId String
  clientPage   ClientPage @relation(fields: [clientPageId], references: [id], onDelete: Cascade)

  label        String
  url          String
  order        Int        @default(0)

  @@index([clientPageId])
}

model GalleryImage {
  id           String     @id @default(cuid())
  clientPageId String
  clientPage   ClientPage @relation(fields: [clientPageId], references: [id], onDelete: Cascade)

  url          String
  caption      String?
  order        Int        @default(0)

  @@index([clientPageId])
}
